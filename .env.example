# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Leave PRIVATE_KEY unset (or DRY_RUN=true) to simulate: real book, real decisions, orders rest for one
# block and fill when a real print crosses their price.
PRIVATE_KEY=
DRY_RUN=true
# To send any transaction, set DRY_RUN=false AND ENABLE_LIVE_TRADING=true.
# Use a fresh, dedicated wallet. Live restarts refuse to trade until manually reconciled.
ENABLE_LIVE_TRADING=false
# Live API binds to 127.0.0.1 by default (paper binds to 0.0.0.0). The API has no authentication.
# SERVER_HOST=127.0.0.1
# Required in live mode: existing PRIVATE persistent directory (chmod 700), never /tmp or ephemeral storage.
# A marker is created before startup and blocks automatic restarts. See README before clearing it.
LIVE_STATE_DIR=
# No startup deposits by default. Deposit MON/USDC into Kuru margin yourself first.
# If you explicitly enable deposits, targets below are used; USDC approval is for the exact deposit.
AUTO_DEPOSIT_MARGIN=false
# Maximum time spent reading the book and evaluating the model BEFORE a quote can be sent.
# Default 750ms paper, 200ms live; lower budgets can cause many skipped blocks on public RPC.
# MAX_PRE_SEND_MS=750

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Every block posts one post-only limit order of this size on the side the model picked, this many ticks
# inside the touch (0 joins the best bid/ask). Kuru MON-USDC minimum order is 200 MON; tick is 0.000001.
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION_MON=1000
BANKROLL_USD=100
# Risk stops are checked BEFORE a quote. Set/touch data/PAUSE to stop new quotes without stopping the feed.
# Remove data/PAUSE to resume. Session budgets reset on restart, so they are not durable loss limits.
# Allow modest head/read RPC skew in either direction; pause if the gap is larger.
MAX_BOOK_AGE_BLOCKS=10
MAX_SPREAD_BPS=100
MAX_SESSION_GAS_MON=1
# Wallet MON must exceed this cap plus two cancellation allowances at MAX_FEE_GWEI.
MAX_SESSION_LOSS_USD=10
MAX_MARGIN_AGE_MS=10000
MAX_EVENT_LOG_MB=20
RPC_TIMEOUT_MS=2000
# Indicative price used in model-spend/P&L estimates; check TypeSafe's actual price yourself.
JEV_USD_PER_MTOK=0.042

# Kuru limit orders draw from the margin account, not the wallet. Only when AUTO_DEPOSIT_MARGIN=true
# does startup top up to these targets. Asks need margin MON, bids need margin USDC.
MARGIN_MON=600
MARGIN_USDC=20
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, so the limit is hardcoded and eth_estimateGas never runs in the loop.
# Unset: estimated once at startup (needs margin funds), else 350000. Expect ~0.03 MON per block live.
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

PORT=3000
